rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. FUNCIONES DE VALIDACIÓN ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRealUser() {
      return isAuthenticated() && request.auth.token.email != null;
    }
    
    function userData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data;
    }

    function hasRole(role) {
      return isRealUser() && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email)) &&
             role in userData().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSecurity() {
      return hasRole('seguridad') || isAdmin();
    }

    function isReception() {
      return hasRole('recepcion') || isAdmin();
    }

    function isClient() {
      return hasRole('cliente');
    }

    function isStaff() {
      return hasRole('staff');
    }

    function isPublicContactDataValid() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'phone', 'email', 'message', 'createdAt', 'status']) &&
             data.keys().hasAll(['name', 'message', 'createdAt', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.status == 'Pendiente' &&
             data.createdAt == request.time &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100));
    }

    // --- 2. REGLAS DE COLECCIONES - LA PAMPA ---

    match /usuarios/{usuarioId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if true; // TEMPORAL PARA SEEDING
      allow delete: if isAdmin();

      // Permitir actualizar campos propios de sesión o cambio de clave
      allow update: if isAdmin() || (
        isRealUser() && 
        request.auth.token.email == usuarioId && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeSessionId', 'activeSessionAt', 'activeSessionDevice',
          'forcePasswordChange', 'updatedAt'
        ])
      );
    }

    // Registros del terminal biométrico en recepción
    match /registros_biometricos/{id} {
      allow read: if isReception();
      allow create: if isReception();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reportes de mantenimiento del centro
    match /tickets_mantenimiento/{id} {
      allow read: if isClient() || isStaff() || isAdmin();
      allow create: if isClient() || isStaff() || isAdmin();
      allow update: if isClient() || isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // Reservas de Clases y Disciplinas
    match /reservas_wellness/{id} {
      allow read: if isClient() || isAdmin();
      allow create: if isClient();
      allow update: if isClient() || isAdmin();
      allow delete: if isAdmin();
    }

    // Agenda de Clientes (Acceso VIP)
    match /agenda_visitas/{id} {
      allow read: if isReception() || isClient();
      allow create: if isReception() || isClient();
      allow update: if isReception() || isClient();
      allow delete: if isAdmin();
    }

    // Comunidad y Testimonios
    match /mensajes_foro/{id} {
      allow read: if isClient() || isAdmin();
      allow create: if isClient() || isAdmin();
      allow update: if isClient() || isAdmin();
      allow delete: if isAdmin();
    }

    // Formularios de contacto desde la Landing Page
    match /contactos_landing/{id} {
      allow create: if isPublicContactDataValid();
      allow read, write: if isAdmin();
    }

    // Regla por defecto de seguridad estricta
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
